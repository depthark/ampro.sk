---
import { site } from "@/data/site";
---

<div class="brand">
  <p class="wordmark"><strong>AM</strong><span>pro.SK</span></p>
  <p class="tagline">
    <span>{site.services.design}</span>
    <span>{site.services.energy}</span>
  </p>
</div>

<style>
  .brand {
    container-type: inline-size;
  }

  .wordmark,
  .tagline {
    --unit: calc(100cqi / 452);
    margin: 0;
    white-space: nowrap;
  }

  .wordmark {
    font-size: calc(98 * var(--unit));
    font-weight: 300;
    letter-spacing: calc(-0.95 * var(--unit));
    line-height: 0.95;
  }

  .wordmark strong {
    font-weight: 700;
  }

  .tagline {
    display: flex;
    justify-content: space-between;
    font-size: calc(15.5 * var(--unit));
    line-height: 1.3;
    text-transform: uppercase;
  }

  .tagline span {
    margin-inline-end: calc(-1 * var(--tracking));
    letter-spacing: var(--tracking);
  }

  .tagline span:first-child {
    --tracking: calc(8.7 * var(--unit));
    color: var(--blue);
  }

  .tagline span:last-child {
    --tracking: calc(7.8 * var(--unit));
    color: var(--green);
  }

  @media (prefers-reduced-motion: no-preference) {
    .wordmark > * {
      display: inline-block;
      transform-origin: center 78%;
      animation: wordmark-drop 740ms 70ms both;
    }

    .wordmark > span {
      animation-delay: 135ms;
    }

    .tagline span {
      animation: tagline-reveal 420ms cubic-bezier(0.2, 0.7, 0.25, 1) 810ms both;
    }

    .tagline span:last-child {
      animation-delay: 910ms;
    }

    @keyframes wordmark-drop {
      0% {
        opacity: 0;
        transform: translateY(clamp(-7rem, -0.72em, -2.5rem)) scale(0.99, 1.045);
        animation-timing-function: cubic-bezier(0.46, 0.06, 0.72, 0.48);
      }

      56% {
        opacity: 1;
        transform: translateY(0.042em) scale(1.025, 0.945);
        animation-timing-function: cubic-bezier(0.18, 0.64, 0.37, 1);
      }

      76% {
        transform: translateY(-0.018em) scale(0.998, 1.015);
        animation-timing-function: ease-in-out;
      }

      100% {
        opacity: 1;
        transform: none;
      }
    }

    @keyframes tagline-reveal {
      from {
        opacity: 0;
        transform: translateY(0.45em);
      }
    }
  }
</style>
