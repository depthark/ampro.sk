---
import { site } from "@/data/site";
---

<div class="brand">
  <p class="wordmark"><strong>AM</strong>pro.SK</p>
  <p class="tagline">
    <span>{site.services.design}</span>
    <span>{site.services.energy}</span>
  </p>
</div>

<style>
  .brand {
    container-type: inline-size;
  }

  .wordmark,
  .tagline {
    --unit: calc(100cqi / 452);
    margin: 0;
    white-space: nowrap;
  }

  .wordmark {
    font-size: calc(98 * var(--unit));
    font-weight: 300;
    letter-spacing: calc(-0.95 * var(--unit));
    line-height: 0.95;
  }

  .wordmark strong {
    font-weight: 700;
  }

  .tagline {
    display: flex;
    justify-content: space-between;
    font-size: calc(15.5 * var(--unit));
    line-height: 1.3;
    text-transform: uppercase;
  }

  .tagline span {
    margin-inline-end: calc(-1 * var(--tracking));
    letter-spacing: var(--tracking);
  }

  .tagline span:first-child {
    --tracking: calc(8.7 * var(--unit));
    color: var(--blue);
  }

  .tagline span:last-child {
    --tracking: calc(7.8 * var(--unit));
    color: var(--green);
  }
</style>
