---
import Brand from "@/components/Brand.astro";
import Icon from "@/components/Icon.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { site } from "@/data/site";

const { person, services } = site;
const contacts = [
  { icon: "device-phone-mobile", label: person.phone, href: `tel:${person.phone.replace(/\s/g, "")}` },
  { icon: "envelope", label: person.email, href: `mailto:${person.email}` },
  { icon: "globe-alt", label: site.webLabel, href: site.url },
];
---

<BaseLayout>
  <div class="screen intro" aria-hidden="true">
    <div class="canvas intro-canvas">
      <div class="intro-logo"><Brand /></div>
    </div>
  </div>

  <main class="screen page" aria-label={site.name}>
    <div class="canvas">
      <div class="content">
        <header class="identity">
          <h1>{person.name}</h1>
          <p>{person.profession} · <span class="blue">{person.designer}</span> · <span class="green">{person.energySpecialist}</span></p>
          <p>{person.role}, {site.company}</p>
        </header>

        <div class="diagram">
          <span class="intersection" aria-hidden="true"></span>
          <span class="marker marker--design blue">
            <span class="badge" aria-hidden="true">P</span>
            <span class="marker-label">{services.designLabel}</span>
          </span>
          <span class="marker marker--energy green">
            <span class="badge" aria-hidden="true">E</span>
            <span class="marker-label">{services.energyLabel}</span>
          </span>
        </div>

        <address class="contact">
          {contacts.map(({ icon, label, href }) => (
            <a href={href}>
              <Icon name={icon} class="contact-icon" />
              <span>{label}</span>
            </a>
          ))}
        </address>

        <p class="wordmark signature" aria-hidden="true"><strong>AM</strong>pro.SK</p>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .screen {
    --surface: #1e1e1e;
    --blue: #89bef2;
    --green: #70c6a3;
    --viewport-block: 100vh;
    display: grid;
    place-items: center;
    min-block-size: max(22rem, var(--viewport-block));
    background: var(--surface);
  }

  @supports (block-size: 100svb) {
    .screen {
      --viewport-block: 100svb;
    }
  }

  .page {
    overflow: clip;
  }

  .canvas {
    container-type: inline-size;
    inline-size: min(100%, max(39.6rem, calc(1.8 * var(--viewport-block))));
    aspect-ratio: 9 / 5;
  }

  .intro {
    display: none;
  }

  .intro-canvas {
    display: grid;
    place-items: center;
  }

  .intro-logo {
    inline-size: min(67%, 54rem);
  }

  .blue {
    color: var(--blue);
  }

  .green {
    color: var(--green);
  }

  .content {
    /* Positions use the reference canvas. Type scales up to a readable maximum. */
    --unit: min(calc(100cqi / 675), 2px);
    --inset: 6.5%;
    --axis-x: 69.1%;
    --axis-y: 59.2%;
    --energy-x: 93.5%;
    --design-y: 15.5%;
    --badge-size: calc(29 * var(--unit));
    --stroke: max(1px, calc(1.5 * var(--unit)));
    --vertical-repeat: max(0.875rem, calc(22 * var(--unit)));
    --horizontal-repeat: max(0.875rem, calc(23 * var(--unit)));
    --dashes: transparent 0, transparent 26%, currentColor 26%, currentColor 74%,
      transparent 74%, transparent 87%, currentColor 87%, currentColor 94%, transparent 94%;
    position: relative;
    block-size: 100%;
  }

  .identity {
    position: absolute;
    inset-block-start: 13%;
    inset-inline-start: var(--inset);
    z-index: 1;
  }

  .identity h1 {
    margin: 0 0 calc(6 * var(--unit));
    font-size: calc(34 * var(--unit));
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .identity p {
    margin: 0;
    color: #c4c4c4;
    font-size: max(0.9375rem, calc(17.5 * var(--unit)));
    font-weight: 300;
    line-height: 1.64;
  }

  .diagram {
    position: absolute;
    inset: 0;
  }

  .diagram::before,
  .diagram::after {
    content: "";
    position: absolute;
    opacity: 0.85;
  }

  .diagram::before {
    inset: var(--design-y) auto min(0px, calc((100% - var(--viewport-block)) / 2)) var(--axis-x);
    inline-size: var(--stroke);
    color: var(--blue);
    background: linear-gradient(to bottom, var(--dashes));
    background-size: 100% var(--vertical-repeat);
    transform: translateX(-50%);
  }

  .diagram::after {
    inset: var(--axis-y) calc(100% - var(--energy-x)) auto min(0px, calc((100% - 100vw) / 2));
    block-size: var(--stroke);
    color: var(--green);
    background: linear-gradient(to right, var(--dashes));
    background-size: var(--horizontal-repeat) 100%;
    transform: translateY(-50%);
  }

  .intersection,
  .marker {
    position: absolute;
    z-index: 1;
    transform: translate(-50%, -50%);
  }

  .intersection {
    inset: var(--axis-y) auto auto var(--axis-x);
    inline-size: max(0.75rem, calc(19 * var(--unit)));
    aspect-ratio: 1;
    background: #fafafa;
  }

  .marker--design {
    inset: var(--design-y) auto auto var(--axis-x);
  }

  .marker--energy {
    inset: var(--axis-y) auto auto var(--energy-x);
  }

  .badge {
    display: grid;
    place-items: center;
    inline-size: var(--badge-size);
    aspect-ratio: 1;
    border: var(--stroke) solid;
    border-radius: 50%;
    background: var(--surface);
    font-size: calc(15 * var(--unit));
    font-weight: 600;
  }

  .marker-label {
    position: absolute;
    font-size: calc(12 * var(--unit));
    font-weight: 600;
    letter-spacing: 0.13em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .marker--design .marker-label {
    inset-block-start: 50%;
    inset-inline-start: calc(100% + 8 * var(--unit));
    transform: translateY(-50%);
  }

  .marker--energy .marker-label {
    inset-block-start: 0;
    inset-inline-end: calc(100% + 9 * var(--unit));
    transform: translateY(-50%);
  }

  .contact {
    position: absolute;
    inset-block-end: clamp(0.5rem, calc(32% - 8rem), 8%);
    inset-inline-start: var(--inset);
    z-index: 1;
    display: grid;
    justify-items: start;
    font-style: normal;
    font-size: max(0.9375rem, calc(17.5 * var(--unit)));
    line-height: 1.35;
  }

  .contact a {
    display: flex;
    align-items: center;
    gap: calc(14 * var(--unit));
    min-block-size: max(2.75rem, calc(30 * var(--unit)));
    color: inherit;
    text-decoration: none;
  }

  .contact a:hover,
  .contact a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .contact a:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 2px;
  }

  .contact :global(.contact-icon) {
    flex: none;
    inline-size: max(1.1rem, calc(20 * var(--unit)));
    block-size: auto;
    color: #c4c4c4;
  }

  .signature {
    position: absolute;
    inset: auto var(--inset) 10.7% auto;
    margin: 0;
    font-size: calc(26 * var(--unit));
    font-weight: 300;
    letter-spacing: -0.035em;
    line-height: 1;
    white-space: nowrap;
  }

  .signature strong {
    font-weight: 700;
  }

  @media (prefers-reduced-motion: no-preference) {
    .intro {
      position: fixed;
      inset: 0;
      z-index: 2;
      display: grid;
      place-items: center;
      background: #171717;
      pointer-events: none;
      animation: intro-exit 1.45s ease forwards;
    }

    .content {
      animation: content-reveal 560ms cubic-bezier(0.21, 0.65, 0.32, 1) 850ms both;
    }

    .diagram::before {
      transform-origin: top center;
      animation:
        draw-vertical 690ms ease-out 1.1s both,
        flow-vertical 1.85s linear 1.1s infinite;
    }

    .diagram::after {
      transform-origin: left center;
      animation:
        draw-horizontal 720ms ease-out 1.34s both,
        flow-horizontal 1.45s linear 1.34s infinite;
    }

    .marker--design {
      animation: detail-reveal 350ms ease-out 1.05s both;
    }

    .intersection {
      animation: detail-reveal 310ms ease-out 1.55s both;
    }

    .marker--energy {
      animation: detail-reveal 380ms ease-out 1.92s both;
    }

    :global(body:focus-within) .intro {
      display: none;
    }

    .page:focus-within .content {
      animation: none;
    }

    @keyframes intro-exit {
      0%, 53% { opacity: 1; }
      100% { opacity: 0; visibility: hidden; }
    }

    @keyframes content-reveal {
      from { opacity: 0; transform: translateY(12px); }
    }

    @keyframes draw-vertical {
      from { transform: translateX(-50%) scaleY(0); }
    }

    @keyframes draw-horizontal {
      from { transform: translateY(-50%) scaleX(0); }
    }

    @keyframes flow-vertical {
      to { background-position-y: var(--vertical-repeat); }
    }

    @keyframes flow-horizontal {
      to { background-position-x: var(--horizontal-repeat); }
    }

    @keyframes detail-reveal {
      from { opacity: 0; scale: 0.7; }
    }
  }

  @media (max-width: 43rem) {
    .canvas {
      inline-size: 100%;
      min-block-size: max(31rem, var(--viewport-block));
      aspect-ratio: auto;
    }

    .intro-logo {
      inline-size: min(80%, 28.25rem);
    }

    .content {
      --axis-x: 86%;
      --axis-y: 51%;
      --energy-x: 94.5%;
      --design-y: 40%;
      --inset: clamp(1.125rem, 7vw, 3rem);
      --badge-size: 1.625rem;
      min-block-size: inherit;
    }

    .identity {
      inset-inline-end: var(--inset);
    }

    .identity h1 {
      margin-block-end: 0.3rem;
      font-size: clamp(1.5rem, 6.2vw, 2.5rem);
    }

    .identity p {
      font-size: clamp(0.9375rem, 3.7vw, 1.125rem);
    }

    .badge {
      font-size: 0.75rem;
    }

    .marker-label {
      font-size: clamp(0.625rem, 2.75vw, 0.75rem);
    }

    .marker--design .marker-label {
      inset-inline: auto calc(100% + 0.5rem);
    }

    .marker--energy .marker-label {
      inset-inline-end: calc(100% + 0.35rem);
    }

    .contact {
      font-size: 1rem;
    }

    .contact a {
      gap: 0.65rem;
    }

    .signature {
      inset-block-end: calc(8% + 0.9rem);
      background: var(--surface);
      box-shadow: 0 0 0 0.35rem var(--surface);
      font-size: clamp(0.875rem, 4vw, 1.35rem);
    }
  }

  @media (max-width: 22rem) {
    .signature {
      inset-block-end: calc(8% - 0.875rem);
    }
  }
</style>
